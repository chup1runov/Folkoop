{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FOLKOOP selected objects v1",
  "$comment": "Runtime validator additionally enforces unique IDs, source.object_id equality, chronological period, canonical timestamps, trimmed nonempty fields and 0 < decimal quantity <= 1e9. Quantity is a decimal string, not binary floating point.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "generated_at",
    "records"
  ],
  "properties": {
    "format": {
      "const": "folkoop-selected-objects"
    },
    "version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "quantity",
          "period",
          "place",
          "conditions",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "type": {
            "enum": [
              "need",
              "offer",
              "resource"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "quantity": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^\\d{1,10}(\\.\\d{1,3})?$"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  }
                }
              }
            ]
          },
          "period": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "until"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                  }
                }
              }
            ]
          },
          "place": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "precision",
                  "label"
                ],
                "properties": {
                  "precision": {
                    "const": "unspecified"
                  },
                  "label": {
                    "const": ""
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "precision",
                  "label"
                ],
                "properties": {
                  "precision": {
                    "const": "area"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            ]
          },
          "conditions": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "object_id",
              "updated_at",
              "observed_at",
              "declaration"
            ],
            "properties": {
              "system": {
                "const": "FOLKOOP"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "updated_at": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                  }
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              },
              "declaration": {
                "const": "exporter_statement"
              }
            }
          }
        }
      }
    }
  }
}
